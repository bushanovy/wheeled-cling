<?xml version="1.0" encoding="utf-8"?>
<!--
  3-wheeled 3D3S omnidirectional robot — PASSIVE-COMPLIANT variant.
  Each leg: base_link -> steering_N_link (revolute, vertical axis)
                      -> pitch_N_link    (revolute PASSIVE, sprung wheel pitch)
                      -> wheel_N_link     (continuous, drive)
  The pitch joint pivots AT the wheel center, around the wheel carrier's lateral
  axis, so the drive wheel can rock fore/aft while keeping the same wheel link
  names for the C++ adhesion plugin. The pitch joint lets each wheel tilt to seat
  flat on the local surface facet through the slide->wall
  concave corner. URDF has no spring field, so each pitch joint is centered by a
  JointPositionController (PD-to-zero) defined in the <gazebo> section below.
  Implements the revolute "R" of the 1P1R passive-compliant suspension in
  Jia et al. 2025 (JFR). The prismatic "P" (surface-normal standoff) is the next
  increment. Baseline rigid model: robot_3d3s.urdf (unchanged).
-->
<robot name="robot_3d3s">

  <!-- ====================== BASE FOOTPRINT ====================== -->
  <!-- Virtual ground-plane link at wheel-contact height (z≈0 from base_link). -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <!-- ======================== BASE LINK ======================== -->
  <!-- Main robot body. All three steering legs attach here. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.00054034 5.1289E-09 0.28559" rpy="0 0 0" />
      <mass value="6.0461" />
      <inertia
        ixx="0.02261"  ixy="1.2023E-09" ixz="2.1633E-10"
        iyy="0.02261"  iyz="-4.0683E-10"
        izz="0.039117" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_3d3s/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>
    <!-- Minimal chassis collision. The old r=0.43 m cylinder enclosed the whole
         footprint and hit the wall before the wheels could transition from slide
         to wall, creating an artificial corner lock. Wheel collisions are the
         intended environment contacts in this climbing sim. -->
    <collision>
      <origin xyz="0 0 0.286" rpy="0 0 0" />
      <geometry>
        <box size="0.18 0.18 0.12"/>
      </geometry>
    </collision>
  </link>

  <!-- ==================== LEG 1 — STEERING ==================== -->
  <!-- Steering assembly for wheel 1 (front). Rotates around vertical Z axis. -->
  <link name="steering_1_link">
    <inertial>
      <origin xyz="0.00045928 -9.1606E-12 0.12605" rpy="0 0 0" />
      <mass value="0.53024" />
      <inertia
        ixx="0.00056656"  ixy="-1.8538E-13" ixz="-7.4564E-08"
        iyy="0.00052285"  iyz="7.8557E-14"
        izz="0.00030054" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_3d3s/meshes/steering_1_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0 0.5 1 1" />
      </material>
    </visual>
    <!-- Minimal bracket collision; wheel contact handles the climb surfaces. -->
    <collision>
      <origin xyz="0 0 0.105" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.04 0.06"/>
      </geometry>
    </collision>
  </link>

  <!--
    Steering joint 1 — revolute around local Z (vertical axis after parent transform).
    Limits: ±2.618 rad (±150°) giving a 300° total range to avoid body collision.
  -->
  <joint name="steering_1_joint" type="revolute">
    <origin xyz="0.38905 0 0.225" rpy="3.1416 0 0" />
    <parent link="base_link" />
    <child  link="steering_1_link" />
    <axis xyz="0 0 1" />
    <limit lower="-2.618" upper="2.618" effort="60" velocity="12" />
  </joint>

  <!-- ==================== LEG 1 — WHEEL ==================== -->
  <!-- Drive wheel 1. Continuous joint — spins freely around its axle. -->
  <link name="wheel_1_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.3566" />
      <inertia
        ixx="0.00048671"  ixy="2.1534E-20"  ixz="-6.1158E-21"
        iyy="0.00031774"  iyz="-2.7551E-22"
        izz="0.00031755" />
    </inertial>
    <visual>
      <origin xyz="0.025 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_3d3s/meshes/wheel_1_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <!-- Leave collision UNNAMED: sdformat's URDF parser then names it
         'wheel_1_link_collision' (referenced by the contact sensor below).
         A custom name gets mangled to '..._fixed_joint_lump__..._collision'. -->
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Locked wheel carrier for wheel 1. This joint is kept as a zero-range
       revolute joint so ros2_control / joint_state_broadcaster can still expose
       the same frame chain, but the wheel cannot pitch away from the steering
       fork during climbing. Steering sets wheel yaw; wheel_*_joint only spins. -->
  <link name="pitch_1_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.15" />
      <inertia ixx="1.0E-4" ixy="0" ixz="0" iyy="1.0E-4" iyz="0" izz="1.0E-4" />
    </inertial>
  </link>
  <joint name="pitch_1_joint" type="revolute">
    <origin xyz="0 0 0.17497" rpy="0 0 0" />
    <parent link="steering_1_link" />
    <child  link="pitch_1_link" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0" effort="200" velocity="0.01" />
    <dynamics damping="20.0" friction="5.0" />
  </joint>

  <!-- Wheel 1 spins around the X axis of this joint frame (perpendicular to wheel face). -->
  <joint name="wheel_1_joint" type="continuous">
    <origin xyz="0 0 0" rpy="-1.5708 0 0" />
    <parent link="pitch_1_link" />
    <child  link="wheel_1_link" />
    <axis xyz="1 0 0" />
    <limit effort="40" velocity="30" />
  </joint>

  <!-- ==================== LEG 2 — STEERING ==================== -->
  <!-- Steering assembly for wheel 2 (rear-left), offset 120° from leg 1. -->
  <link name="steering_2_link">
    <inertial>
      <origin xyz="0.00045928 -8.9114E-12 0.12605" rpy="0 0 0" />
      <mass value="0.53024" />
      <inertia
        ixx="0.00056656"  ixy="-1.8531E-13" ixz="-7.4564E-08"
        iyy="0.00052285"  iyz="7.8355E-14"
        izz="0.00030054" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_3d3s/meshes/steering_2_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0 0.5 1 1" />
      </material>
    </visual>
    <!-- Minimal bracket collision; wheel contact handles the climb surfaces. -->
    <collision>
      <origin xyz="0 0 0.105" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.04 0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- Steering joint 2 — same limits as joint 1. -->
  <joint name="steering_2_joint" type="revolute">
    <origin xyz="-0.19453 0.33693 0.225" rpy="3.1416 0 2.0944" />
    <parent link="base_link" />
    <child  link="steering_2_link" />
    <axis xyz="0 0 1" />
    <limit lower="-2.618" upper="2.618" effort="60" velocity="12" />
  </joint>

  <!-- ==================== LEG 2 — WHEEL ==================== -->
  <!-- Drive wheel 2 — continuous, same inertia as wheel 1. -->
  <link name="wheel_2_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.3566" />
      <inertia
        ixx="0.00048671"  ixy="2.2267E-20"  ixz="4.0658E-20"
        iyy="0.00031774"  iyz="-9.0783E-22"
        izz="0.00031755" />
    </inertial>
    <visual>
      <origin xyz="0.025 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_3d3s/meshes/wheel_2_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Locked wheel carrier for wheel 2 (see leg 1 for rationale). -->
  <link name="pitch_2_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.15" />
      <inertia ixx="1.0E-4" ixy="0" ixz="0" iyy="1.0E-4" iyz="0" izz="1.0E-4" />
    </inertial>
  </link>
  <joint name="pitch_2_joint" type="revolute">
    <origin xyz="0 0 0.17497" rpy="0 0 0" />
    <parent link="steering_2_link" />
    <child  link="pitch_2_link" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0" effort="200" velocity="0.01" />
    <dynamics damping="20.0" friction="5.0" />
  </joint>

  <joint name="wheel_2_joint" type="continuous">
    <origin xyz="0 0 0" rpy="-1.5708 0 0" />
    <parent link="pitch_2_link" />
    <child  link="wheel_2_link" />
    <axis xyz="1 0 0" />
    <limit effort="40" velocity="30" />
  </joint>

  <!-- ==================== LEG 3 — STEERING ==================== -->
  <!--
    Steering assembly for wheel 3 (rear-right), offset 240° from leg 1.
    NOTE: SolidWorks exported zero inertia for this link — fixed by using the
    same measured values as steering_1 and steering_2 (identical part).
  -->
  <link name="steering_3_link">
    <inertial>
      <origin xyz="0.00045928 -9.1606E-12 0.12605" rpy="0 0 0" />
      <mass value="0.53024" />
      <inertia
        ixx="0.00056656"  ixy="-1.8538E-13" ixz="-7.4564E-08"
        iyy="0.00052285"  iyz="7.8557E-14"
        izz="0.00030054" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_3d3s/meshes/steering_3_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0 0.5 1 1" />
      </material>
    </visual>
    <!-- Minimal bracket collision; wheel contact handles the climb surfaces. -->
    <collision>
      <origin xyz="0 0 0.105" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.04 0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- Steering joint 3 — same limits as joints 1 and 2. -->
  <joint name="steering_3_joint" type="revolute">
    <origin xyz="-0.19453 -0.33693 0.225" rpy="3.1416 0 -2.0944" />
    <parent link="base_link" />
    <child  link="steering_3_link" />
    <axis xyz="0 0 1" />
    <limit lower="-2.618" upper="2.618" effort="60" velocity="12" />
  </joint>

  <!-- ==================== LEG 3 — WHEEL ==================== -->
  <!-- Drive wheel 3 — continuous, same inertia as wheels 1 and 2. -->
  <link name="wheel_3_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.3566" />
      <inertia
        ixx="0.00048671"  ixy="2.3818E-20"  ixz="2.7105E-20"
        iyy="0.00031774"  iyz="-1.7287E-21"
        izz="0.00031755" />
    </inertial>
    <visual>
      <origin xyz="0.025 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_3d3s/meshes/wheel_3_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0" />
      <geometry>
        <cylinder radius="0.05" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Locked wheel carrier for wheel 3 (see leg 1 for rationale). -->
  <link name="pitch_3_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.15" />
      <inertia ixx="1.0E-4" ixy="0" ixz="0" iyy="1.0E-4" iyz="0" izz="1.0E-4" />
    </inertial>
  </link>
  <joint name="pitch_3_joint" type="revolute">
    <origin xyz="0 0 0.17497" rpy="0 0 0" />
    <parent link="steering_3_link" />
    <child  link="pitch_3_link" />
    <axis xyz="0 1 0" />
    <limit lower="0" upper="0" effort="200" velocity="0.01" />
    <dynamics damping="20.0" friction="5.0" />
  </joint>

  <joint name="wheel_3_joint" type="continuous">
    <origin xyz="0 0 0" rpy="-1.5708 0 0" />
    <parent link="pitch_3_link" />
    <child  link="wheel_3_link" />
    <axis xyz="1 0 0" />
    <limit effort="40" velocity="30" />
  </joint>


  <!-- =================== ros2_control — Gazebo simulation hardware =================== -->
  <ros2_control name="robot_3d3s" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="steering_1_joint">
      <command_interface name="position">
        <param name="min">-2.618</param>
        <param name="max"> 2.618</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="steering_2_joint">
      <command_interface name="position">
        <param name="min">-2.618</param>
        <param name="max"> 2.618</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="steering_3_joint">
      <command_interface name="position">
        <param name="min">-2.618</param>
        <param name="max"> 2.618</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Passive compliant wheel-pitch joints. They are centered by Gazebo
         JointPositionController plugins below, but ros2_control must expose
         their state so joint_state_broadcaster can publish TF through them. -->
    <joint name="pitch_1_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="pitch_2_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="pitch_3_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wheel_1_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_2_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel_3_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- gz_ros2_control Gazebo plugin — controllers.yaml path injected by gazebo.launch.py -->
  <gazebo>
    <plugin filename="librobot_3d3s_kmw100_adhesion_system.so"
            name="robot_3d3s::Kmw100AdhesionSystem">
      <enabled>true</enabled>
      <adhesion_model>gap_decay</adhesion_model>
      <force_n>900.0</force_n>
      <min_force_n>0.0</min_force_n>
      <force_table_csv></force_table_csv>
      <wall_thickness_mm>10.0</wall_thickness_mm>
      <max_lookup_gap_mm>-1.0</max_lookup_gap_mm>
      <min_wall_force_n>350.0</min_wall_force_n>
      <gap_reference_mm>3.0</gap_reference_mm>
      <gap_bias_mm>0.0</gap_bias_mm>
      <wheel_radius_m>0.05</wheel_radius_m>
      <wheel_width_m>0.05</wheel_width_m>
      <max_gap_m>0.06</max_gap_m>
      <full_contact_depth_m>0.002</full_contact_depth_m>
      <min_contact_fraction>0.10</min_contact_fraction>
      <corner_contact_fraction>0.85</corner_contact_fraction>
      <corner_capture_m>0.08</corner_capture_m>
      <safe_tilt_deg>20.0</safe_tilt_deg>
      <cutoff_tilt_deg>60.0</cutoff_tilt_deg>
      <ground_z>0.0</ground_z>
      <slide_angle_deg>45.0</slide_angle_deg>
      <slide_start_x>-0.15</slide_start_x>
      <slide_start_z>0.0</slide_start_z>
      <slide_wall_x>0.95</slide_wall_x>
      <flat_panel_thickness_m>0.10</flat_panel_thickness_m>
      <enable_opposite_wall>true</enable_opposite_wall>
      <surface_margin_m>0.08</surface_margin_m>
      <debug_period_s>1.0</debug_period_s>
      <status_period_s>0.05</status_period_s>
      <status_topic>/model/robot_3d3s/adhesion_status</status_topic>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
    </plugin>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>CONTROLLERS_YAML_PATH</parameters>
    </plugin>
  </gazebo>

  <!-- Rubber-coated magnetic wheels on dry steel. mu=1.0 gives strong
       traction without unrealistically locking steering under adhesion. -->
  <gazebo reference="wheel_1_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1e6</kp>
    <kd>50.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
    <sensor name="wheel_1_contact" type="contact">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <contact>
        <collision>wheel_1_link_collision</collision>
        <topic>/robot_3d3s/wheel_1_contacts</topic>
      </contact>
    </sensor>
  </gazebo>
  <gazebo reference="wheel_2_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1e6</kp>
    <kd>50.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
    <sensor name="wheel_2_contact" type="contact">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <contact>
        <collision>wheel_2_link_collision</collision>
        <topic>/robot_3d3s/wheel_2_contacts</topic>
      </contact>
    </sensor>
  </gazebo>
  <gazebo reference="wheel_3_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1e6</kp>
    <kd>50.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
    <sensor name="wheel_3_contact" type="contact">
      <always_on>1</always_on>
      <update_rate>100</update_rate>
      <contact>
        <collision>wheel_3_link_collision</collision>
        <topic>/robot_3d3s/wheel_3_contacts</topic>
      </contact>
    </sensor>
  </gazebo>

  <!-- ============ Wheel-pitch lock controllers ============ -->
  <!-- Extra PD hold at zero. The joint limits above are the real lock; these
       controllers keep Gazebo numerically settled at zero under contact load. -->
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>pitch_1_joint</joint_name>
      <p_gain>200.0</p_gain>
      <d_gain>5.0</d_gain>
      <i_gain>0.0</i_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>pitch_2_joint</joint_name>
      <p_gain>200.0</p_gain>
      <d_gain>5.0</d_gain>
      <i_gain>0.0</i_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>pitch_3_joint</joint_name>
      <p_gain>200.0</p_gain>
      <d_gain>5.0</d_gain>
      <i_gain>0.0</i_gain>
    </plugin>
  </gazebo>

</robot>
