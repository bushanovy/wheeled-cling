<?xml version="1.0" ?>
<sdf version="1.8">
    <world name="default">
        <gravity>0 0 -9.8</gravity>
        <physics name="1ms" type="ignored">
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>        
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
        <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
        <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry><plane><normal>0 0 1</normal></plane></geometry>
                </collision>
                <visual name="visual">
                    <geometry><plane><normal>0 0 1</normal></plane></geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 45 degree steel slide for the C++ KMW100 ground-to-wall test.
             The upper face starts flush with the ground near x=-0.15, so the
             robot can drive from the ground onto the ramp and then the wall. -->
        <model name="steel_slide_45deg">
            <static>true</static>
            <pose>0.430 0 0.552 0 -0.7854 0</pose>
            <link name="slide_link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>1.60 1.20 0.04</size>
                        </box>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>1.0</mu>
                                <mu2>1.0</mu2>
                            </ode>
                        </friction>
                    </surface>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>1.60 1.20 0.04</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.24 0.02 0.03 1</ambient>
                        <diffuse>0.45 0.05 0.06 1</diffuse>
                        <specular>0.35 0.12 0.12 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Flat adhesion test panel.
             The robot starts on the -X side of this panel. The face used for
             climbing is at x=0.95 with outward normal -X. -->
        <model name="flat_steel_panel">
            <static>true</static>
            <pose>1.0 0 1.5 0 0 0</pose>
            <link name="panel_link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.10 3.00 3.00</size>
                        </box>
                    </geometry>
                    <surface>
                        <friction>
                            <ode>
                                <mu>1.0</mu>
                                <mu2>1.0</mu2>
                            </ode>
                        </friction>
                    </surface>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.10 3.00 3.00</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.20 0.02 0.03 1</ambient>
                        <diffuse>0.38 0.04 0.05 1</diffuse>
                        <specular>0.32 0.10 0.10 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Curved-pipe mockup disabled for the flat adhesion test.
             Use mockup_contact_test.sdf / mockup_contact_test.launch.py for
             the COMSOL contact-fraction mockup validation.
        <include>
            <uri>model://mockup_structure</uri>
            <pose>0 0 0 1.5708 0 0</pose>
        </include>
        -->

    </world>
</sdf>
